# dependencies
/node_modules

# next.js
/.next
/out

# env
.env
.env.local
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# misc
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo

# vercel
.vercel

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code — o que é do projeto entra, o que é da máquina fica de fora.
# O settings.local.json guarda caminho absoluto e permissões pessoais.
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/settings.json

# Supabase CLI (local state)
supabase/.temp/

# Stockfish WASM binaries (copied via setup script)
public/stockfish/

# Test artifacts
/test-results/
/playwright-report/

# Rascunhos de trabalho (renders de arte, consultas ao banco, comparações).
# Ficam no repositório para que os scripts enxerguem node_modules, mas nunca
# são versionados.
/.scratch/

# Screenshots de validação manual (val-*.png, validation-*.png).
# Ficavam soltos na raiz do repositório, 2,8 MB, sem serem versionados nem
# ignorados — apareciam em todo `git status` e mascaravam mudanças reais.
/.validation-shots/
/val-*.png
/validation-*.png

# Saída do avatar:garment — regenerável, e sai daqui para public/items no Bloco 7b
scripts/avatar/uniformes/

# Cópia dos uniformes para a página de conferência /dev/avatar-uniforme.
# NÃO é public/items/: `verify:avatar-assets` reprova arquivo órfão lá dentro, e
# a linha do uniforme em `items` só nasce no Bloco 7b.
public/dev/

# Playwright MCP (screenshots e snapshots de sessao)
.playwright-mcp/
