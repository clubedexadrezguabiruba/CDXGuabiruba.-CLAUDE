# ============================================================
# Recruta 64 — variáveis de ambiente
#
# Local: copie para .env.local e preencha.
# CI:    as mesmas quatro variáveis são secrets do GitHub Actions
#        (ver .github/workflows/ci.yml).
# ============================================================

# --- Cliente (expostas ao browser) -------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Servidor (NUNCA expor no client) ----------------------
# Usada pelos gates de verificação e pelo e2e para criar/remover
# usuários de teste. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Connection string direta do Postgres, usada por
# scripts/apply-migration.ts e pelos gates que inspecionam o schema.
# Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL="postgresql://postgres:SENHA@HOST:5432/postgres"

# NOTA: no .env.local deste projeto a connection string está gravada como uma
# LINHA SOLTA, sem o prefixo SUPABASE_DB_URL=. scripts/verify/db-url.ts aceita
# as duas formas: prioriza a variável de ambiente e cai para varrer o arquivo
# atrás de uma linha começando com postgres://.
